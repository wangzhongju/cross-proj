[Unit]
Description=es-fand contorls the fan speed by detecting the system temperature
After=local-fs.target

[Service]
Type=forking
# Define PID file path (consistent with es-fand.sh file).
PIDFile=/run/es-fand.pid
ExecStart=/usr/bin/es-fand.sh start
ExecStop=/usr/bin/es-fand.sh stop
# Configure log output to journal.
StandardOutput=journal
StandardError=journal
# Kill the entire process group when stopping.
KillMode=control-group

[Install]
WantedBy=multi-user.target
